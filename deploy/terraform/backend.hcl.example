# Copy to backend.hcl (gitignored), then:
#   tofu init -backend-config=backend.hcl
#
# The bucket must exist before the first init and must have versioning
# enabled — it is the only copy of the state.

bucket = "vetsync-tfstate"
key    = "prd/terraform.tfstate"
region = "nl-ams"

endpoints = {
  s3 = "https://s3.nl-ams.scw.cloud"
}

access_key = "SCWXXXXXXXXXXXXXXXXX"
secret_key = "00000000-0000-0000-0000-000000000000"
